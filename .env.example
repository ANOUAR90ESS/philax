# ---------------------------------------------------------------------------
# Philax environment configuration. Copy to `.env` and fill in values.
# Never commit real values. All keys below are read server-side only.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- API server ---
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173
# Reverse-proxy hops whose X-Forwarded-For is trusted (0 when the API is exposed directly).
TRUST_PROXY_HOPS=0
# Secret used to sign session cookies (min 32 chars). Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Database (PostgreSQL 15+ with pgvector). Works with local Postgres or Supabase. ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/philax
# Used only by integration/E2E tests. Must point to a disposable database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/philax_test

# --- Supabase (optional: only needed if you host Postgres on Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers (at least one is required to generate debates) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Model tiers: "<provider>:<model>" with optional comma-separated fallbacks.
# Leave empty to use the defaults documented in docs/ai/architecture.md for
# whichever providers have keys configured.
LLM_TIER_FAST=
LLM_TIER_STRONG=
LLM_TIER_PREMIUM=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- Embeddings (optional; without them retrieval uses PostgreSQL full-text search only) ---
# "<provider>:<model>", e.g. openai:text-embedding-3-small or google:gemini-embedding-001
EMBEDDING_MODEL=

# --- Content extraction ---
# Without a key the built-in Readability extractor is used.
FIRECRAWL_API_KEY=

# --- Character media (optional; server-side only, never exposed to the browser) ---
# Without keys the app runs and shows "Provider not configured"; turns stay readable as text.
# There is no default voice or avatar: each character's ElevenLabs voice and HeyGen
# avatar are configured per character (see docs/architecture/character-media.md).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# HeyGen API key (rendered avatar video segments, MEDIA_AVATAR_MODE=video).
HEYGEN_API_KEY=
# HeyGen LiveAvatar API key (real-time avatars, MEDIA_AVATAR_MODE=live).
LIVEAVATAR_API_KEY=
# live | video | off
MEDIA_AVATAR_MODE=live
# Prepare a missing voice (ElevenLabs Voice Design) or avatar (HeyGen, video mode) automatically
# the first time a character is selected; the result is saved and reused. Spends credits once per character.
MEDIA_AUTO_PREPARE=true
# Real-time avatar sessions this server keeps open at once (each user has at most one).
MEDIA_MAX_LIVE_SESSIONS=4

# --- Billing (not part of MVP; reserved) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability / analytics (optional) ---
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Web app (exposed to the browser: never put secrets here) ---
VITE_API_URL=http://localhost:4000
